# Copy to .env and adjust. Every WSLA_ setting is listed in the README.

# Required: the port the API listens on
PORT=7860

# auto = GPU when one is visible, else CPU. Also: gpu, cpu
# WSLA_DEVICE=auto

# PaddleOCR fallback
# WSLA_ENABLE_OCR_FALLBACK=true
# WSLA_FALLBACK_MIN_CHARS_PER_PAGE=50

# Quality trigger: pages below this accented-character rate are re-read.
# Raise it (e.g. 0.015) to trade speed for accent fidelity.
# WSLA_ENABLE_QUALITY_TRIGGER=true
# WSLA_FALLBACK_MIN_ACCENT_RATE=0.008
